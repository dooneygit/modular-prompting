{
  "manifest_version": 3,
  "name": "Quick Prompting",
  "version": "0.1.0",
  "key": "",
  "description": "Save, organize, and reuse your prompts",
  "permissions": ["storage", "clipboardWrite"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Quick Prompting"
  },
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://www.perplexity.ai/*",
        "https://perplexity.ai/*",
        "https://copilot.microsoft.com/*"
      ],
      "js": ["src/content/index.ts"]
    }
  ]
}
